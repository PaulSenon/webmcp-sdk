{
  "name": "@senon/webmcp-sdk-docs-infra",
  "version": "0.0.0",
  "private": true,
  "description": "Infrastructure as code (Alchemy v2) for the webmcp-sdk documentation site on Cloudflare Workers static assets. Not published.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
