    "dev": "DO_NOT_TRACK=1 alchemy dev"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-node": "4.1.2",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "typescript": "7.0.2"
  }
