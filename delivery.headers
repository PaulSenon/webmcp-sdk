# Project response headers for the docs site, appended by infra/site (local hook, see
# docs/docs-deploy.md "Kit divergences") after the kit's own rules (X-Content-Type-Options,
# Referrer-Policy, X-Robots-Tag off production, X-Delivery-Revision, /r/*). Cloudflare `_headers`
# format: https://developers.cloudflare.com/workers/static-assets/headers/ (100 rules, 2,000 chars
# per line). Do not repeat a header the kit already sets: values would be joined with a comma.
#
# CSP: same-origin only. 'unsafe-inline' for scripts is required by the prerendered TanStack Start
# pages (inline serialized router state, theme anti-flash script; no per-request nonce on a static
# site). Verified with zero violations in Playwright under workerd on the real build.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
# Vite's content-hashed output (apps/docs). Not /__tsr/* (named after the function, not the content).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
