{
  "name": "webmcp-sdk",
  "version": "0.0.0-design",
  "private": true,
  "description": "Prototype: contract-first, Standard Schema-based TypeScript SDK for WebMCP tools. Core and React implemented; not published.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:docs": "node scripts/check-readme.mjs",
    "check": "pnpm typecheck && pnpm check:docs && pnpm typecheck:e2e",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:react18": "vitest run --config vitest.react18.config.ts",
    "test:e2e": "playwright test --project=polyfill",
    "test:e2e:native": "WEBMCP_NATIVE=1 playwright test --project=native",
    "test:all": "pnpm check && pnpm test && pnpm test:react18 && pnpm test:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.100",
    "@ai-sdk/react": "^4.0.169",
    "@playwright/test": "1.59.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/browser-playwright": "5.1.0",
    "@w3c/webmcp-polyfill": "0.1.0",
    "ai": "^7.0.165",
    "arktype": "^2.2.9",
    "happy-dom": "^21.0.4",
    "playwright": "1.59.1",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "7.3.5",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  }
}
